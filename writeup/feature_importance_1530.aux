\relax 
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The design is float throughout, but not all continuous: distinct values per column in each 2000-session window (median over the 147 windows) --- what MDI's cardinality bias keys on.}}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Spearman rank correlation, over the non-constant columns, between a column's importance and its number of distinct values. MDI, split count and TreeSHAP track cardinality; permutation importance does not.}}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Noise probes: on every third refit a second fit appends three pure-noise columns (continuous; 20 values; binary). Median rank among all columns (1 = most important) and, in brackets, the share of the real columns the model uses that rank below the probe; permutation P2 of the continuous probe ($\Delta $QLIKE $\times 10^{3}$, 95\% interval) against \texttt  {har\_ma\_*}'s.}}{2}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces All-features design, series level: top three per model and measure (share for MDI / split / $|\beta \cdot sd|$ / SHAP; change as \% of the model's tail loss for permutation and drop-column).}}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces All features: ranked bars per measure (series level; top 8). Rows: models; columns: the built-in measure, split count (trees) / drop-column (linear), permutation P2 on the tail, SHAP. Bars with 95\% intervals over refits. Linear permutation / drop-column in $\Delta $MSE (see Section 6).}}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Within a tree model: Spearman between measures (series / column level).}}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Within a linear model: Spearman between measures.}}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Across models, same measure: range of Spearman over tree--tree pairs, tree--linear pairs, and ridge--lasso.}}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces All features: rank of every series under every model $\times $ measure (1 = most important).}}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Top-5 stability (series level): share of the 147 refits in which \texttt  {har\_ma\_*} is in the refit's top 5; number of series in the top 5 in at least half the refits; number ever in the top 5. Measures: built-in (MDI or $|\beta sd|$), permutation P2 ($\Delta $QLIKE trees, $\Delta $MSE linear), SHAP.}}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Regimes: Spearman between the ranking within a stratum and the full-sample ranking (series level): median (minimum) over the calendar years (2018: 13, 2019: 26, 2020: 25, 2021: 25, 2022: 25, 2023: 25, 2024: 8 refits) and over the causal VIX terciles (VIX at 15:30 against the 1/3, 2/3 quantiles of the previous 2000 sessions' 15:30 VIX: low 28, mid 38, high 81 refits); years in which the full-sample leader also leads.}}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Joint permutation of a cluster against the sum of its columns permuted one at a time (P2, $\Delta $MSE in the fit space $\times 10^{3}$, joint / sum; squared error so the linear columns are not dominated by single tails), for the four clusters with the largest joint effect in LightGBM. Joint $>$ sum: the columns substitute for one another and one-at-a-time permutation understates the group (dilution). Joint $<$ sum: offsetting weights (permuting one column breaks an offset its partner carries).}}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces The top linear QLIKE entries: mean [95\% interval], median refit, share of the sum carried by one refit.}}{6}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Causally tuned trees (their own extracts: gain per refit and TreeSHAP rows at 16:00): \texttt  {har\_ma\_*} share tuned (untuned), rank correlation tuned vs untuned over the series, and the next three series by tuned SHAP. Split count and permutation were not computed for the tuned trees (their per-refit configurations would have to be refitted).}}{6}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces HAR + calendar, series level: top three per model and measure.}}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces HAR + calendar: ranked bars per measure.}}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces HAR + calendar: ranks across measures.}}{8}{}\protected@file@percent }
