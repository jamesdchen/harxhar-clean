# local config / cluster run-state (not code)
.claude/
.hpc/campaigns/*/*.lock
.hpc/campaigns/*/drive*.log
.hpc/campaigns/*/drive_state.json
.hpc/campaigns/*/driver_stdout.log

# synced per-run OOS predictions (regenerable; large) — notebooks recompute from these when present
results/moe_ladder/preds/

# every-bar window-ablation per-bar losses (large; regenerable by re-harvesting from the cluster / winablate_r1.py)
results/winablate_full/*_lossbar.npz

# Pack journal state (bind records/receipts are machine-local journal, never committed)
.hpc/packs/

# Rebuilt feature caches (regenerable, ~2GB)
results/b2_mmap/
results/prep_cache_*.npz
