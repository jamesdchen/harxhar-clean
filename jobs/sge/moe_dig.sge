#!/bin/bash
#$ -N moe_dig
#$ -cwd
#$ -t 1-90
#$ -l h_data=12G,h_rt=3:00:00
#$ -pe shared 4
#$ -o /u/scratch/j/jamesdc1/harxhar-clean/logs/
#$ -j y
# Hoffman2/SGE port of jobs/slurm/moe_dig.sbatch. Regime stage = input-saturation + shrunk + feature-subsampled
# bagged MoE. JSON cfgs HARDCODED (SGE -v splits on commas, like SLURM --export); simple vars (CID,
# RDEPTH, RDIAG, LBL, WD) come via -v. SGE_TASK_ID is 1-based -> chunk index = SGE_TASK_ID-1.
cd /u/scratch/j/jamesdc1/harxhar-clean
export PYTHONPATH="$PWD:$PWD/experiments${PYTHONPATH:+:$PYTHONPATH}"
export TQDM_DISABLE=1 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
PY=/u/home/j/jamesdc1/.conda/envs/hpc-pi/bin/python
export GLOBAL_CFG="{\"n_estimators\":200,\"learning_rate\":0.03,\"subsample\":0.7,\"colsample_bytree\":0.5,\"min_child_weight\":50.0,\"reg_lambda\":2.0,\"n_jobs\":4,\"max_depth\":${GDEPTH:-8}}"
DIAG=${RDIAG:-false}
export REGIME_CFG="{\"depth\":${RDEPTH},\"expert\":\"${EXPERT:-fm}\",\"rank\":${RANK:-8},\"fm_linear\":${FMLIN:-true},\"wd_v\":${WDV:-null},\"basis\":\"${BASIS:-none}\",\"n_knots\":${NKNOTS:-3},\"gate_kind\":\"${GATEKIND:-tree}\",\"gate_context\":\"${GCTX:-expert}\",\"num_regimes\":${NREG:-4},\"gate_temp\":${GTEMP:-1.0},\"epochs\":${EPOCHS:-150},\"hidden_dim\":16,\"dropout\":0.15,\"n_bags\":${NBAGS:-8},\"colsample\":0.5,\"lr\":0.001,\"gate_lr\":${GLR:-null},\"weight_decay\":${WD:-0.1},\"gate_weight_decay\":${GWD:-null},\"aux_weight\":${AUXW:-0.5},\"val_frac\":0.2,\"patience\":${PATIENCE:-12},\"use_diagnostic_mlp\":${DIAG}}"
# NOREG=1 -> empty regime cfg (preds_chunk skips the regime stage) = base+global ONLY (the no-regime
# baseline at this GDEPTH, for the structural-starvation depth ladder).
[ "${NOREG:-0}" = "1" ] && export REGIME_CFG="{}"
export REGIME_MODEL=${RMODEL:-moe}
export REGIME_FULL=${RFULL:-0}
export REGIME_INVERT=${RINV:-0}  # 1 -> regime-then-global (un-starve the gate); default 0 = global-then-regime
export REGIME_NOGLOBAL=${RNOG:-0}  # 1 (with RINV=1) -> drop d8 entirely = base + regime only (purest un-starve)
IDX=$((SGE_TASK_ID - 1))
$PY experiments/resid_amortized.py chunk_task "$CID" resid_regime "$IDX" 90 "$LBL" 2>&1 | grep -E 'CHUNK|MOE_DIAG|Error|Traceback'
