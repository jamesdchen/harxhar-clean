#!/bin/bash
#$ -N unifs
#$ -cwd
#$ -l h_data=32G,h_rt=6:00:00
#$ -t 1-100
#$ -o /u/scratch/j/jamesdc1/harxhar-clean/logs/
#$ -j y
# Unification campaign task, SERIAL variant: one (arm, chunk), one core.
#
# Why no parallel environment: the linear arms are single-threaded numpy
# (rank-one rolling updates + one dense solve per bar). Requesting `-pe
# shared 4` made these queue for slots they never use; a 1-core request
# schedules against a far larger pool. BLAS threading is pinned to 1 so a
# task cannot oversubscribe the core it was granted. (pyarrow's parquet
# reader keeps its own thread pool during the panel build and ignores
# those variables; measured CPU/wall is ~2.4 there, ~1.0 afterwards.)
#
# h_data=32G, and the history is worth keeping because two earlier values
# were wrong in opposite directions. 24G scheduled only ~69 concurrent
# tasks (memory per slot governs node packing, so an over-generous
# reservation costs concurrency directly). 18G then died with a numpy
# MemoryError mid-build: that value came from a maxvmem reading taken
# while tasks were still crashing on the fork bug below, so they never
# reached peak and the reading was biased low. Sized from the panel
# instead: 300317 x 1273 float64 is 3.1G for X alone, and the rebuild
# holds raw copies plus pandas merge intermediates on top.
#
# Submit with:  qsub -N unif_<arm> -v ARM=<arm> jobs/sge/unification_serial.sge
cd /u/scratch/j/jamesdc1/harxhar-clean
export PYTHONPATH="$PWD:$PWD/experiments${PYTHONPATH:+:$PYTHONPATH}"
export TQDM_DISABLE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
# The panel rebuild fans column scaling over PROCESSES sized by
# os.cpu_count() -- the node's cores, not our grant. SGE bills each child's
# full address space against h_vmem, so 8 forks of a 15G process ask for
# ~120G and die with ENOMEM before a single chunk is written. Pin it to
# the slots we actually hold.
export UNIF_SCALE_PROCS="${NSLOTS:-1}"
PY=/u/home/j/jamesdc1/.conda/envs/hpc-pi/bin/python
# Idempotent resume: a chunk that already produced its npz is done.
OUT=$(printf 'results/unification/%s/chunk_%03d.npz' "$ARM" $((SGE_TASK_ID - 1)))
[ -f "$OUT" ] && { echo "SKIP existing $OUT"; exit 0; }
$PY experiments/run_unification.py --arm "$ARM" --chunk-index "$((SGE_TASK_ID - 1))" \
    --output-dir results/unification
